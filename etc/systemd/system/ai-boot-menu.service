[Unit]
Description=AI Boot Pro 1.3 Main Menu
# 不能写 After=multi-user.target：它自己被 multi-user.target 拉起，会形成 ordering cycle，
# 某些时序下 systemd 会丢掉这个 job → 进了系统但没有菜单（现场故障）。
After=systemd-user-sessions.service getty.target
Conflicts=getty@tty1.service

[Service]
Type=idle
# 开机先装拉丁字体（安全默认，绝不出现方块）；中文时 common.sh 会再换 CJK 字体
ExecStartPre=-/usr/bin/setfont -C /dev/tty1 /usr/share/consolefonts/Lat15-Fixed16.psf.gz
ExecStart=/usr/local/bin/ai-boot-menu.sh
StandardInput=tty
StandardOutput=tty
# 脚本报错也要落在 tty1，现场能看见，而不是只进 journal
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# 任何异常退出都回到菜单（getty@tty1 已被 Conflict 掉，否则会黑屏）
Restart=always
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
